@model Household
<form method="post" class="form-panel">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3"><label asp-for="PrimaryContactName" class="form-label">Primary contact</label><input asp-for="PrimaryContactName" class="form-control" autocomplete="name" /><span asp-validation-for="PrimaryContactName" class="text-danger"></span></div>
    <div class="row"><div class="col-md-6 mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" autocomplete="email" /><span asp-validation-for="Email" class="text-danger"></span></div>
        <div class="col-md-6 mb-3"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control" autocomplete="tel" /><span asp-validation-for="Phone" class="text-danger"></span></div></div>
    <div class="mb-3"><label asp-for="HouseholdSize" class="form-label">Number of people in household</label><input asp-for="HouseholdSize" class="form-control" min="1" /><span asp-validation-for="HouseholdSize" class="text-danger"></span></div>
    <div class="mb-4"><label asp-for="Notes" class="form-label">Staff notes</label><textarea asp-for="Notes" class="form-control" rows="3"></textarea><span asp-validation-for="Notes" class="text-danger"></span></div>
    <button class="btn btn-primary" type="submit">Save household</button> <a class="btn btn-link" asp-action="Index">Cancel</a>
</form>
