@model DonationFormViewModel
@{ ViewData["Title"] = "Receive donation"; }
<div class="page-heading"><div><p class="eyebrow mb-1">INCOMING FOOD</p><h1 class="h2 mb-0">Receive a donation</h1></div></div>
<form method="post" class="form-panel donation-form">
    <div asp-validation-summary="All" class="text-danger mb-3"></div>
    <div class="row"><div class="col-md-6 mb-3"><label asp-for="DonorId" class="form-label">Donor</label><select asp-for="DonorId" asp-items="Model.Donors" class="form-select"><option value="">Choose donor</option></select><span asp-validation-for="DonorId" class="text-danger"></span><a asp-controller="Donors" asp-action="Create" class="small">Add a donor</a></div>
        <div class="col-md-6 mb-3"><label asp-for="PantrySiteId" class="form-label">Receiving pantry</label><select asp-for="PantrySiteId" asp-items="Model.PantrySites" class="form-select"><option value="">Choose pantry</option></select><span asp-validation-for="PantrySiteId" class="text-danger"></span></div></div>
    <div class="mb-3"><label asp-for="ReceivedAt" class="form-label">Received date</label><input asp-for="ReceivedAt" asp-format="{0:yyyy-MM-dd}" type="date" class="form-control" /><span asp-validation-for="ReceivedAt" class="text-danger"></span></div>
    <h2 class="h5 mt-3">Items received</h2>
    <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Food item</th><th>Quantity</th><th>Best before</th></tr></thead><tbody>
    @for (int index = 0; index < Model.Items.Count; index++)
    {
        <tr><td><input asp-for="Items[index].FoodItemId" type="hidden" /><span class="fw-semibold">@Model.Items[index].Name</span> <span class="text-muted">(@Model.Items[index].Unit)</span></td>
            <td><input asp-for="Items[index].Quantity" class="form-control" type="number" min="0" step="0.01" aria-label="Quantity of @Model.Items[index].Name" /></td>
            <td><input asp-for="Items[index].BestBefore" asp-format="{0:yyyy-MM-dd}" class="form-control" type="date" aria-label="Best before date for @Model.Items[index].Name" /></td></tr>
    }
    </tbody></table></div>
    <div class="mb-4"><label asp-for="Notes" class="form-label">Donation notes</label><textarea asp-for="Notes" class="form-control" rows="2"></textarea><span asp-validation-for="Notes" class="text-danger"></span></div>
    <button class="btn btn-primary">Save donation and update stock</button> <a class="btn btn-link" asp-action="Index">Cancel</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
