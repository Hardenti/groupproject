@model IReadOnlyList<Distribution>
@{ ViewData["Title"] = "Distributions"; }
<div class="page-heading"><div><p class="eyebrow mb-1">HOUSEHOLD SUPPORT</p><h1 class="h2 mb-0">Distributions</h1></div><a asp-action="Create" class="btn btn-primary">Prepare distribution</a></div>
<partial name="_Alerts" />
<div class="panel-card">
    <form method="get" class="search-toolbar mb-3"><div class="search-box"><label for="search" class="form-label">Search household or pantry</label><input id="search" name="search" value="@ViewBag.Search" class="form-control" /></div>
        <div><label for="sort" class="form-label">Sort by</label><select id="sort" name="sort" class="form-select"><option value="recent">Newest first</option><option value="household" selected="@(ViewBag.Sort == "household")">Household</option></select></div><button class="btn btn-outline-secondary">Search</button></form>
    <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Date</th><th>Household</th><th>Pantry</th><th>Food lines</th><th>Notes</th><th></th></tr></thead><tbody>
    @foreach (Distribution distribution in Model)
    {
        <tr><td>@distribution.DistributedAt.ToString("MMM d, yyyy h:mm tt")</td><td class="fw-semibold">@distribution.Household?.PrimaryContactName</td><td>@distribution.PantrySite?.Name</td><td>@distribution.Lines.Count</td><td>@(distribution.Notes ?? "—")</td>
            <td class="text-end table-actions"><a asp-action="Details" asp-route-id="@distribution.DistributionId" class="btn btn-sm btn-outline-secondary">Details</a><a asp-action="Edit" asp-route-id="@distribution.DistributionId" class="btn btn-sm btn-outline-secondary">Edit</a>
                <form asp-action="Delete" asp-route-id="@distribution.DistributionId" method="post" class="d-inline" onsubmit="return confirm('Delete this distribution and return its items to stock?');"><button class="btn btn-sm btn-outline-danger">Delete</button></form></td></tr>
    }
    </tbody></table></div>
    @if (Model.Count == 0) { <p class="empty-note mb-0">No distributions found.</p> }
</div>
