@model InventoryLot
@{ ViewData["Title"] = "Manual stock entry"; }
<div class="page-heading"><div><p class="eyebrow mb-1">STOCK MANAGEMENT</p><h1 class="h2 mb-0">Manual stock entry</h1></div></div>
<form method="post" class="form-panel"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3"><label asp-for="FoodItemId" class="form-label">Food item</label><select asp-for="FoodItemId" asp-items="ViewBag.FoodItemId" class="form-select"><option value="">Choose item</option></select><span asp-validation-for="FoodItemId" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="PantrySiteId" class="form-label">Pantry site</label><select asp-for="PantrySiteId" asp-items="ViewBag.PantrySiteId" class="form-select"><option value="">Choose site</option></select><span asp-validation-for="PantrySiteId" class="text-danger"></span></div>
    <div class="row"><div class="col-md-6 mb-3"><label asp-for="QuantityReceived" class="form-label">Quantity received</label><input asp-for="QuantityReceived" class="form-control" min="0" step="0.01" /><span asp-validation-for="QuantityReceived" class="text-danger"></span></div>
        <div class="col-md-6 mb-3"><label asp-for="QuantityRemaining" class="form-label">Quantity on hand</label><input asp-for="QuantityRemaining" class="form-control" min="0" step="0.01" /><span asp-validation-for="QuantityRemaining" class="text-danger"></span></div></div>
    <div class="row"><div class="col-md-6 mb-4"><label asp-for="ReceivedAt" class="form-label">Received date</label><input asp-for="ReceivedAt" asp-format="{0:yyyy-MM-dd}" class="form-control" type="date" /></div>
        <div class="col-md-6 mb-4"><label asp-for="ExpiresOn" class="form-label">Expiry date (optional)</label><input asp-for="ExpiresOn" asp-format="{0:yyyy-MM-dd}" class="form-control" type="date" /></div></div>
    <button class="btn btn-primary">Save stock lot</button> <a class="btn btn-link" asp-action="Index">Cancel</a></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
